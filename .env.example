# Скопируйте в .env и при необходимости поменяйте. Без .env используются значения ниже.
POSTGRES_USER=unicorn
POSTGRES_PASSWORD=unicorn
POSTGRES_DB=unicorn

# Ключ, которым подписываем сессию. Пусто - сервер придумает случайный сам, после пересоздания
# контейнера все войдут заново. На сервере задать свой: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true, если сайт открывают по https
COOKIE_SECURE=false

# Вход в демо-аккаунты без пароля запросом POST /api/auth/demo. Кнопок на экране нет, поэтому выключен:
# в демо-аккаунты входят по почте и паролю ниже
DEMO_LOGIN=false

# Демо-аккаунты, создаются при запуске. На открытом сервере поменять пароли:
# при следующем запуске они сменятся и у уже созданных аккаунтов
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo12345
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=admin12345

# Почта для кода при регистрации и писем "Забыли пароль". Пусто - регистрация без кода, а ссылка на новый
# пароль ложится в служебную таблицу "Письма без отправки" в админке. Для ящика на Яндексе: smtp.yandex.ru, порт 465, логин - адрес ящика,
# пароль - пароль приложения (id.yandex.ru, Безопасность, Пароли приложений), а не пароль от ящика
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# От кого письмо. Пусто - от SMTP_USER
MAIL_FROM=
# Адрес сайта для ссылки в письме, как его открывают люди
SITE_URL=http://localhost:3000

# Порты на этом компьютере
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Для стенда в интернете (docs/stand.md). У себя на компьютере не нужны.
# Там же обязательно заменить SESSION_SECRET, POSTGRES_PASSWORD и пароли демо-аккаунтов выше:
# без них стенд не запустится. Демо-вход и COOKIE_SECURE на стенде заданы в docker-compose.stand.yml
# Домен стенда, на него Caddy получит сертификат https
SITE_ADDRESS=
# Логин и хеш пароля на весь сайт. Хеш: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'пароль'
# Вставлять в одинарных кавычках: в хеше есть знаки $
SITE_USER=expert
SITE_PASSWORD_HASH=
